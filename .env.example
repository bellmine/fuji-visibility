# Copy to .env for a local/VPS deployment. Do not commit .env.
FUJI_TIMEZONE=Asia/Tokyo
FUJI_DEFAULT_LOCATION=kawaguchiko
FUJI_DEFAULT_START_HOUR=5
FUJI_DEFAULT_END_HOUR=12
FUJI_DEFAULT_ARRIVAL_AFTER=08:00
FUJI_MODELS=auto,jma_seamless,jma_msm,jma_gsm,gfs_seamless,ecmwf_ifs025
FUJI_CLOUD_STRATEGY=mid
# Phase 3.1 field-level decision thresholds.
FUJI_MIN_PROXY=75
FUJI_MIN_FULL_PROXY_MODELS=2
FUJI_MAX_PROXY_SPREAD_STRONG=15
FUJI_MAX_PROXY_SPREAD_WEAK=25
FUJI_GOOD_MID_CLOUD_MAX=25
FUJI_GOOD_VISIBILITY_MIN_KM=25
FUJI_GOOD_PRECIP_MAX=30
FUJI_GOOD_HUMIDITY_MAX=80
FUJI_MIN_WINDOW_HOURS=2
# Phase 3.2 hourly browser ranking block length.
FUJI_BEST_BLOCK_HOURS=2
FUJI_SNAPSHOT_INTERVAL_HOURS=3
FUJI_MANUAL_REFRESH_COOLDOWN_SECONDS=300
FUJI_UPCOMING_DAYS=7
FUJI_RAW_RETENTION_DAYS=30
FUJI_DB_PATH=/app/data/fuji_forecasts.sqlite
FUJI_RAW_DATA_DIR=/app/data/raw
FUJI_REFRESH_LOCK_PATH=/app/data/refresh.lock
FUJI_WEB_HOST=0.0.0.0
FUJI_WEB_PORT=8000
# UID/GID that owns the bind-mounted data directory on the host.
# Change these to the output of `id -u` and `id -g` on the deployment host.
FUJI_CONTAINER_UID=1001
FUJI_CONTAINER_GID=1001
